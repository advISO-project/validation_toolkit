{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://adviso-project.github.io/validation_toolkit/schemas/comparison-configuration-v1.0.schema.json",
  "title": "AdvISO comparison configuration",
  "description": "Normative structural schema for comparison-configuration schema version 1.0.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "metadata",
    "fields"
  ],
  "properties": {
    "schema_version": {
      "const": "1.0"
    },
    "metadata": {
      "$ref": "#/$defs/configurationMetadata"
    },
    "fields": {
      "$ref": "#/$defs/fields"
    }
  },
  "$defs": {
    "nonEmptyString": {
      "type": "string",
      "minLength": 1
    },
    "uniqueNonEmptyStrings": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {
        "$ref": "#/$defs/nonEmptyString"
      }
    },
    "configurationMetadata": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "revision"
      ],
      "properties": {
        "id": {
          "$ref": "#/$defs/nonEmptyString"
        },
        "revision": {
          "$ref": "#/$defs/nonEmptyString"
        },
        "title": {
          "type": "string"
        },
        "description": {
          "type": "string"
        }
      }
    },
    "fields": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "record_key",
        "in_scope",
        "definitions"
      ],
      "properties": {
        "record_key": {
          "$ref": "#/$defs/uniqueNonEmptyStrings"
        },
        "in_scope": {
          "$ref": "#/$defs/uniqueNonEmptyStrings"
        },
        "definitions": {
          "type": "object",
          "minProperties": 1,
          "propertyNames": {
            "$ref": "#/$defs/nonEmptyString"
          },
          "additionalProperties": {
            "$ref": "#/$defs/fieldDefinition"
          }
        }
      }
    },
    "fieldDefinition": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "source_fields",
        "required",
        "null_policy",
        "comparator"
      ],
      "properties": {
        "source_fields": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "reference",
            "query"
          ],
          "properties": {
            "reference": {
              "$ref": "#/$defs/nonEmptyString"
            },
            "query": {
              "$ref": "#/$defs/nonEmptyString"
            }
          }
        },
        "required": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "reference",
            "query"
          ],
          "properties": {
            "reference": {
              "type": "boolean"
            },
            "query": {
              "type": "boolean"
            }
          }
        },
        "logical_type": {
          "$ref": "#/$defs/logicalType"
        },
        "null_policy": {
          "$ref": "#/$defs/nullPolicy"
        },
        "source_normalisation": {
          "type": "object",
          "additionalProperties": false,
          "minProperties": 1,
          "properties": {
            "reference": {
              "type": "array",
              "minItems": 1,
              "items": {
                "$ref": "#/$defs/sourceNormalisation"
              }
            },
            "query": {
              "type": "array",
              "minItems": 1,
              "items": {
                "$ref": "#/$defs/sourceNormalisation"
              }
            }
          }
        },
        "collection_representation": {
          "$ref": "#/$defs/collectionRepresentation"
        },
        "value_mapping": {
          "$ref": "#/$defs/valueMapping"
        },
        "typed_normalisation": {
          "type": "array",
          "minItems": 1,
          "items": {
            "$ref": "#/$defs/typedNormalisation"
          }
        },
        "comparator": {
          "$ref": "#/$defs/comparator"
        },
        "review_priority": {
          "default": "normal",
          "enum": [
            "low",
            "normal",
            "high"
          ]
        }
      },
      "allOf": [
        {
          "if": {
            "not": {
              "required": [
                "logical_type"
              ]
            }
          },
          "then": {
            "properties": {
              "comparator": {
                "properties": {
                  "name": {
                    "const": "preserved_exact"
                  }
                }
              }
            },
            "not": {
              "anyOf": [
                {
                  "required": [
                    "value_mapping"
                  ]
                },
                {
                  "required": [
                    "typed_normalisation"
                  ]
                },
                {
                  "required": [
                    "collection_representation"
                  ]
                }
              ]
            }
          }
        },
        {
          "if": {
            "properties": {
              "comparator": {
                "properties": {
                  "name": {
                    "const": "preserved_exact"
                  }
                },
                "required": [
                  "name"
                ]
              }
            },
            "required": [
              "comparator"
            ]
          },
          "then": {
            "not": {
              "anyOf": [
                {
                  "required": [
                    "logical_type"
                  ]
                },
                {
                  "required": [
                    "source_normalisation"
                  ]
                },
                {
                  "required": [
                    "value_mapping"
                  ]
                },
                {
                  "required": [
                    "typed_normalisation"
                  ]
                },
                {
                  "required": [
                    "collection_representation"
                  ]
                },
                {
                  "properties": {
                    "null_policy": {
                      "required": [
                        "missing_tokens"
                      ]
                    }
                  },
                  "required": [
                    "null_policy"
                  ]
                }
              ]
            }
          }
        },
        {
          "if": {
            "required": [
              "collection_representation"
            ]
          },
          "then": {
            "properties": {
              "logical_type": {
                "type": "object"
              }
            },
            "required": [
              "logical_type"
            ]
          }
        },
        {
          "if": {
            "properties": {
              "logical_type": {
                "type": "object"
              }
            },
            "required": [
              "logical_type"
            ]
          },
          "then": {
            "not": {
              "anyOf": [
                {
                  "required": [
                    "source_normalisation"
                  ]
                },
                {
                  "required": [
                    "value_mapping"
                  ]
                },
                {
                  "required": [
                    "typed_normalisation"
                  ]
                }
              ]
            }
          }
        }
      ]
    },
    "scalarLogicalType": {
      "enum": [
        "string",
        "integer",
        "decimal",
        "boolean",
        "date",
        "datetime"
      ]
    },
    "logicalType": {
      "oneOf": [
        {
          "$ref": "#/$defs/scalarLogicalType"
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "collection_type",
            "element_type",
            "element_comparator"
          ],
          "properties": {
            "collection_type": {
              "enum": [
                "list",
                "set",
                "multiset"
              ]
            },
            "element_type": {
              "$ref": "#/$defs/scalarLogicalType"
            },
            "element_comparator": {
              "$ref": "#/$defs/comparator"
            }
          },
          "allOf": [
            {
              "properties": {
                "element_comparator": {
                  "properties": {
                    "name": {
                      "enum": [
                        "typed_exact",
                        "numeric_tolerance"
                      ]
                    }
                  }
                }
              }
            },
            {
              "if": {
                "properties": {
                  "collection_type": {
                    "enum": [
                      "set",
                      "multiset"
                    ]
                  }
                },
                "required": [
                  "collection_type"
                ]
              },
              "then": {
                "properties": {
                  "element_comparator": {
                    "properties": {
                      "name": {
                        "const": "typed_exact"
                      }
                    }
                  }
                }
              }
            },
            {
              "if": {
                "properties": {
                  "element_comparator": {
                    "properties": {
                      "name": {
                        "const": "numeric_tolerance"
                      }
                    },
                    "required": [
                      "name"
                    ]
                  }
                },
                "required": [
                  "element_comparator"
                ]
              },
              "then": {
                "properties": {
                  "collection_type": {
                    "const": "list"
                  },
                  "element_type": {
                    "enum": [
                      "integer",
                      "decimal"
                    ]
                  }
                }
              }
            }
          ]
        }
      ]
    },
    "nullPolicy": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "allowed",
        "nulls_equal"
      ],
      "properties": {
        "allowed": {
          "type": "boolean"
        },
        "nulls_equal": {
          "type": "boolean"
        },
        "missing_tokens": {
          "type": "object",
          "additionalProperties": false,
          "minProperties": 1,
          "properties": {
            "reference": {
              "type": "array",
              "minItems": 1,
              "items": {
                "$ref": "#/$defs/nonNullSourceValueDescriptor"
              }
            },
            "query": {
              "type": "array",
              "minItems": 1,
              "items": {
                "$ref": "#/$defs/nonNullSourceValueDescriptor"
              }
            }
          }
        }
      },
      "allOf": [
        {
          "if": {
            "properties": {
              "allowed": {
                "const": false
              }
            },
            "required": [
              "allowed"
            ]
          },
          "then": {
            "properties": {
              "nulls_equal": {
                "const": false
              }
            }
          }
        }
      ]
    },
    "sourceValueDescriptor": {
      "oneOf": [
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "category",
            "value"
          ],
          "properties": {
            "category": {
              "const": "string"
            },
            "value": {
              "type": "string"
            }
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "category",
            "value"
          ],
          "properties": {
            "category": {
              "const": "integer"
            },
            "value": {
              "type": "string",
              "pattern": "^-?(?:0|[1-9][0-9]*)$"
            }
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "category",
            "value"
          ],
          "properties": {
            "category": {
              "const": "decimal"
            },
            "value": {
              "type": "string",
              "pattern": "^-?(?:(?:0|[1-9][0-9]*)\\.[0-9]+|(?:0|[1-9][0-9]*)(?:[eE][+-]?[0-9]+)|(?:0|[1-9][0-9]*)\\.[0-9]+(?:[eE][+-]?[0-9]+))$"
            }
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "category",
            "value"
          ],
          "properties": {
            "category": {
              "const": "boolean"
            },
            "value": {
              "type": "boolean"
            }
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "category"
          ],
          "properties": {
            "category": {
              "const": "null"
            }
          }
        }
      ]
    },
    "nonNullSourceValueDescriptor": {
      "allOf": [
        {
          "$ref": "#/$defs/sourceValueDescriptor"
        },
        {
          "not": {
            "properties": {
              "category": {
                "const": "null"
              }
            },
            "required": [
              "category"
            ]
          }
        }
      ]
    },
    "sourceNormalisation": {
      "oneOf": [
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "operation",
            "parameters"
          ],
          "properties": {
            "operation": {
              "const": "unicode_normalise"
            },
            "parameters": {
              "type": "object",
              "additionalProperties": false,
              "required": [
                "form"
              ],
              "properties": {
                "form": {
                  "enum": [
                    "NFC",
                    "NFD",
                    "NFKC",
                    "NFKD"
                  ]
                }
              }
            }
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "operation",
            "parameters"
          ],
          "properties": {
            "operation": {
              "const": "trim"
            },
            "parameters": {
              "type": "object",
              "additionalProperties": false,
              "required": [
                "side"
              ],
              "properties": {
                "side": {
                  "enum": [
                    "leading",
                    "trailing",
                    "both"
                  ]
                }
              }
            }
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "operation"
          ],
          "properties": {
            "operation": {
              "const": "case_fold"
            },
            "parameters": {
              "type": "object",
              "maxProperties": 0
            }
          }
        }
      ]
    },
    "collectionRepresentation": {
      "type": "object",
      "additionalProperties": false,
      "minProperties": 1,
      "properties": {
        "reference": {
          "$ref": "#/$defs/collectionRepresentationSide"
        },
        "query": {
          "$ref": "#/$defs/collectionRepresentationSide"
        }
      }
    },
    "collectionRepresentationSide": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "format"
      ],
      "properties": {
        "format": {
          "enum": [
            "json_array",
            "delimited_text"
          ]
        },
        "delimiter": {
          "type": "string",
          "minLength": 1
        },
        "element_normalisation": {
          "type": "array",
          "minItems": 1,
          "items": {
            "$ref": "#/$defs/sourceNormalisation"
          }
        },
        "element_mapping": {
          "type": "array",
          "minItems": 1,
          "items": {
            "$ref": "#/$defs/nonNullValueMappingEntry"
          }
        }
      },
      "allOf": [
        {
          "if": {
            "properties": {
              "format": {
                "const": "delimited_text"
              }
            },
            "required": [
              "format"
            ]
          },
          "then": {
            "required": [
              "delimiter"
            ]
          },
          "else": {
            "not": {
              "required": [
                "delimiter"
              ]
            }
          }
        }
      ]
    },
    "typedNormalisation": {
      "oneOf": [
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "operation",
            "parameters"
          ],
          "properties": {
            "operation": {
              "const": "decimal_quantise"
            },
            "parameters": {
              "type": "object",
              "additionalProperties": false,
              "required": [
                "places",
                "rounding"
              ],
              "properties": {
                "places": {
                  "type": "integer",
                  "minimum": 0
                },
                "rounding": {
                  "enum": [
                    "half_even",
                    "half_up",
                    "down"
                  ]
                }
              }
            }
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "operation",
            "parameters"
          ],
          "properties": {
            "operation": {
              "const": "datetime_truncate"
            },
            "parameters": {
              "type": "object",
              "additionalProperties": false,
              "required": [
                "precision"
              ],
              "properties": {
                "precision": {
                  "enum": [
                    "second",
                    "millisecond",
                    "microsecond"
                  ]
                }
              }
            }
          }
        }
      ]
    },
    "valueMapping": {
      "type": "object",
      "additionalProperties": false,
      "minProperties": 1,
      "properties": {
        "reference": {
          "type": "array",
          "minItems": 1,
          "items": {
            "$ref": "#/$defs/valueMappingEntry"
          }
        },
        "query": {
          "type": "array",
          "minItems": 1,
          "items": {
            "$ref": "#/$defs/valueMappingEntry"
          }
        }
      }
    },
    "valueMappingEntry": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "from",
        "to"
      ],
      "properties": {
        "from": {
          "$ref": "#/$defs/nonNullSourceValueDescriptor"
        },
        "to": {
          "$ref": "#/$defs/sourceValueDescriptor"
        }
      }
    },
    "nonNullValueMappingEntry": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "from",
        "to"
      ],
      "properties": {
        "from": {
          "$ref": "#/$defs/nonNullSourceValueDescriptor"
        },
        "to": {
          "$ref": "#/$defs/nonNullSourceValueDescriptor"
        }
      }
    },
    "comparator": {
      "oneOf": [
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "name"
          ],
          "properties": {
            "name": {
              "enum": [
                "preserved_exact",
                "typed_exact",
                "normalised_string",
                "numeric_exact",
                "date_exact",
                "datetime_exact",
                "list_exact",
                "set_exact",
                "multiset_exact"
              ]
            }
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "name",
            "parameters"
          ],
          "properties": {
            "name": {
              "const": "numeric_tolerance"
            },
            "parameters": {
              "type": "object",
              "additionalProperties": false,
              "minProperties": 1,
              "maxProperties": 1,
              "properties": {
                "absolute_tolerance": {
                  "$ref": "#/$defs/nonNegativeDecimalString"
                },
                "relative_tolerance": {
                  "$ref": "#/$defs/nonNegativeDecimalString"
                }
              }
            }
          }
        }
      ]
    },
    "nonNegativeDecimalString": {
      "type": "string",
      "pattern": "^(?:0|[1-9][0-9]*)(?:\\.[0-9]+)?(?:[eE][+-]?[0-9]+)?$"
    }
  }
}
