        },
        "record_count": {
          "$ref": "#/$defs/nonNegativeInteger"
        },
        "review_priority": {
          "enum": [
            "low",
            "normal",
            "high"
          ]
        },
        "values": {
          "$ref": "#/$defs/findingValues"
        }
      },
      "allOf": [
        {
          "if": {
            "properties": {
              "code": {
                "const": "missing_record"
              }
            },
            "required": [
              "code"
            ]
          },
          "then": {
            "required": [
              "record_identity",
              "source_locations"
            ],
            "properties": {
              "classification": {
                "const": "comparison_difference"
              },
              "phase": {
                "const": "records"
              },
              "affected_side": {
                "const": "query"
              },
              "record_identity": {
                "properties": {
                  "reference": {
                    "$ref": "#/$defs/recordIdentityValues"
                  },
                  "query": {
                    "type": "null"
                  }
