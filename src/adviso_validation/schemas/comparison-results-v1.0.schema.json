            }
          }
        },
        {
          "if": {
            "properties": {
              "code": {
                "const": "extra_record"
              }
            },
            "required": [
              "code"
            ]
          },
          "then": {
            "required": [
              "record_identity",
              "source_locations"
            ],
            "properties": {
              "classification": {
                "const": "comparison_difference"
              },
              "phase": {
                "const": "records"
              },
              "affected_side": {
                "const": "reference"
              },
              "record_identity": {
                "properties": {
                  "reference": {
                    "type": "null"
                  },
                  "query": {
                    "$ref": "#/$defs/recordIdentityValues"
                  }
                }
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "code": {
                "enum": [
                  "type_mismatch",
                  "invalid_field_value",
                  "null_policy_violation",
                  "mapping_failure"
                ]
