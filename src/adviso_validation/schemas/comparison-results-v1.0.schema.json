            "required": [
              "code"
            ]
          },
          "then": {
            "required": [
              "record_identity",
              "source_locations",
              "field",
              "review_priority",
              "values"
            ],
            "properties": {
              "classification": {
                "const": "assessment_issue"
              },
              "phase": {
                "const": "contract"
              },
              "affected_side": {
                "enum": [
