      "properties": {
        "id": {
          "type": "string",
          "pattern": "^F[0-9]{6,}$"
        },
        "classification": {
          "enum": [
            "comparison_difference",
            "assessment_issue"
          ]
        },
        "code": {
          "enum": [
            "missing_record",
            "extra_record",
            "missing_required_field",
            "undeclared_field",
            "type_mismatch",
            "invalid_field_value",
            "null_policy_violation",
            "mapping_failure",
            "value_mismatch"
