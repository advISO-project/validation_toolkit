        },
        "message": {
          "$ref": "#/$defs/nonEmptyString"
        },
        "affected_side": {
          "enum": [
            "reference",
            "query",
            "both"
          ]
        },
        "record_identity": {
          "$ref": "#/$defs/recordIdentity"
        },
        "source_locations": {
